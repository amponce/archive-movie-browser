/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://image.tmdb.org https://archive.org https://*.archive.org; connect-src 'self' https://archive.org https://api.themoviedb.org; media-src 'self' https://archive.org https://*.archive.org; frame-src https://archive.org; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
