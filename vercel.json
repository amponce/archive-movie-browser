{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && npm ci --prefix mcp",
  "functions": {
    "api/mcp.js": {
      "includeFiles": "{public/poster-index.json,public/tv-lineups.json,src/lists/*.json}",
      "maxDuration": 30
    },
    "api/tv.js": {
      "includeFiles": "{public/poster-index.json,public/tv-lineups.json,src/lists/*.json}",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/tv",
      "destination": "/index.html"
    },
    {
      "source": "/api/tv/playlist.m3u",
      "destination": "/api/tv?format=m3u"
    },
    {
      "source": "/api/tv/guide.xml",
      "destination": "/api/tv?format=xml"
    },
    {
      "source": "/browse",
      "destination": "/index.html"
    },
    {
      "source": "/mcp",
      "destination": "/index.html"
    },
    {
      "source": "/stats",
      "destination": "/index.html"
    },
    {
      "source": "/lists",
      "destination": "/index.html"
    },
    {
      "source": "/lists/:slug",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/mcp.html",
      "destination": "/mcp",
      "permanent": true
    },
    {
      "source": "/stats.html",
      "destination": "/stats",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://image.tmdb.org https://archive.org https://*.archive.org; connect-src 'self' https://archive.org https://api.themoviedb.org; media-src https://archive.org https://*.archive.org; frame-src https://archive.org; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), fullscreen=(self \"https://archive.org\"), autoplay=(self \"https://archive.org\")"
        }
      ]
    }
  ]
}
